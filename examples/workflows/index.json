        {
          "name": "miniprogram_simulator_capture",
          "path": "workflows/miniprogram/miniprogram_simulator_capture.yaml",
          "tags": ["verification", "miniprogram"],
          "description": "Capture the WeChat DevTools simulator region as visual evidence."
        },
        {
          "name": "miniprogram_visual_text_contract",
          "path": "workflows/miniprogram/miniprogram_visual_text_contract.yaml",
          "tags": ["miniprogram", "visual-contract"],
