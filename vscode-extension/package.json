{
  "name": "visual-agent",
  "displayName": "Checkpoint",
  "description": "Checkpoint is a local verification panel for AI coding assistants. Run workflows, inspect results, and keep context across coding sessions.",
  "version": "0.1.0",
  "publisher": "visual-agent",
  "license": "MIT",
  "icon": "icons/visual-agent.png",
  "keywords": [
    "checkpoint",
    "visual testing",
    "playwright",
    "AI",
    "workflow"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Xiaoyu155/visual-agent.git",
    "directory": "vscode-extension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Testing",
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "visual-agent",
          "title": "Checkpoint",
          "icon": "icons/visual-agent.svg"
        }
      ]
    },
    "views": {
      "visual-agent": [
        {
          "id": "visualAgentWorkflows",
          "name": "Workflows"
        }
      ]
    },
    "commands": [
      {
        "command": "visualAgent.quickActions",
        "title": "Checkpoint: Quick Actions"
      },
      {
        "command": "visualAgent.initWorkspace",
        "title": "Checkpoint: Init Workspace"
      },
      {
        "command": "visualAgent.runAll",
        "title": "Checkpoint: Run All Workflows"
      },
      {
        "command": "visualAgent.runLiveSupervised",
        "title": "Checkpoint: Run Live Supervised Workflows"
      },
      {
        "command": "visualAgent.runAffected",
        "title": "Checkpoint: Run Affected Workflows"
      },
      {
        "command": "visualAgent.verifyCurrentChange",
        "title": "Checkpoint: Verify Current Change"
      },
      {
        "command": "visualAgent.verifyImplementation",
        "title": "x-agent: Verify Implementation"
      },
      {
        "command": "visualAgent.showLastVerification",
        "title": "Checkpoint: Show Last AI Verification"
      },
      {
        "command": "visualAgent.showLatestFailure",
        "title": "Checkpoint: Show Latest Failure"
      },
      {
        "command": "visualAgent.autoRepair",
        "title": "Checkpoint: Auto Repair Latest Failure"
      },
      {
        "command": "visualAgent.generateWorkflow",
        "title": "Checkpoint: Generate Workflow from Description"
      },
      {
        "command": "visualAgent.newWorkflow",
        "title": "Checkpoint: New Workflow"
      },
      {
        "command": "visualAgent.openExamples",
        "title": "Checkpoint: Open Examples"
      },
      {
        "command": "visualAgent.copyExampleWorkflow",
        "title": "Checkpoint: Copy Example Workflow"
      },
      {
        "command": "visualAgent.browserSmoke",
        "title": "Checkpoint: Browser Smoke URL"
      },
      {
        "command": "visualAgent.connectCloud",
        "title": "Checkpoint: Connect to Cloud (Pro)"
      },
      {
        "command": "visualAgent.refresh",
        "title": "Checkpoint: Refresh"
      }
    ],
    "walkthroughs": [
      {
        "id": "visualAgentOnboarding",
        "title": "Verify with Checkpoint",
        "description": "Initialize a local workspace, verify an implementation, and inspect the result.",
        "steps": [
          {
            "id": "visualAgentInit",
            "title": "Initialize a workspace",
            "description": "Run `Checkpoint: Init Workspace` from the Command Palette.",
            "completionEvents": [
              "onCommand:visualAgent.initWorkspace"
            ]
          },
          {
            "id": "visualAgentVerify",
            "title": "Verify an implementation",
            "description": "Run `x-agent: Verify Implementation` from the Command Palette. Leave the URL blank to let Checkpoint infer it.",
            "completionEvents": [
              "onCommand:visualAgent.verifyImplementation",
              "onCommand:visualAgent.verifyCurrentChange"
            ]
          },
          {
            "id": "visualAgentInspect",
            "title": "Inspect status and failures",
            "description": "Use `Checkpoint: Show Last AI Verification` or `Checkpoint: Show Latest Failure` after a run.",
            "completionEvents": [
              "onCommand:visualAgent.showLastVerification",
              "onCommand:visualAgent.showLatestFailure"
            ]
          }
        ]
      }
    ],
    "configuration": {
      "title": "Checkpoint",
      "properties": {
        "visualAgent.workspaceRoot": {
          "type": "string",
          "default": ".agent-workspace",
          "description": "Workspace root for Checkpoint data."
        },
        "visualAgent.runOnSave": {
          "type": "boolean",
          "default": false,
          "description": "Run affected workflows on file save."
        },
        "visualAgent.autoRunTags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "fast"
          ],
          "description": "Tags to include in auto-run on save."
        },
        "visualAgent.pythonPath": {
          "type": "string",
          "default": "python",
          "description": "Path to Python interpreter."
        },
        "visualAgent.enableTelemetry": {
          "type": "boolean",
          "default": false,
          "description": "Enable Checkpoint telemetry when supported by the Python package. Default: off."
        },
        "visualAgent.maxNotificationChars": {
          "type": "number",
          "default": 500,
          "description": "Maximum CLI output characters shown in notifications."
        }
      }
    },
    "menus": {
      "view/title": [
        {
          "command": "visualAgent.verifyCurrentChange",
          "when": "view == visualAgentWorkflows",
          "group": "navigation@1"
        },
        {
          "command": "visualAgent.autoRepair",
          "when": "view == visualAgentWorkflows",
          "group": "navigation@2"
        },
        {
          "command": "visualAgent.runLiveSupervised",
          "when": "view == visualAgentWorkflows",
          "group": "navigation@3"
        },
        {
          "command": "visualAgent.browserSmoke",
          "when": "view == visualAgentWorkflows",
          "group": "navigation@4"
        },
        {
          "command": "visualAgent.refresh",
          "when": "view == visualAgentWorkflows",
          "group": "navigation@5"
        }
      ],
      "view/item/context": [
        {
          "command": "visualAgent.autoRepair",
          "when": "view == visualAgentWorkflows && viewItem == failedWorkflow",
          "group": "inline@1"
        },
        {
          "command": "visualAgent.showLatestFailure",
          "when": "view == visualAgentWorkflows && viewItem == failedWorkflow",
          "group": "inline@2"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "test": "npm run compile && node test/agentStatus.test.js && node test/integration/bridge.test.js",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.2.1",
    "typescript": "^5.0.0"
  }
}

